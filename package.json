{
  "name": "limit-app",
  "productName": "Limit",
  "version": "0.1.0",
  "private": true,
  "description": "Приватний desktop-трекер часу та лімітів для застосунків",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "node --test electron/*.test.cjs",
    "package": "npm run build && electron-builder --dir",
    "sign:mac:local": "node scripts/sign-macos-local.cjs",
    "dist": "npm run build && electron-builder",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{css,html,json,md,yaml,yml}": "prettier --write"
  },
  "build": {
    "appId": "ua.limit.desktop",
    "productName": "Limit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/*.test.cjs",
      "package.json",
      "!node_modules/@mapbox/**/*",
      "!node_modules/node-gyp/**/*",
      "!node_modules/node-addon-api/**/*",
      "!node_modules/tar/**/*",
      "!node_modules/cacache/**/*",
      "!node_modules/make-fetch-happen/**/*"
    ],
    "asarUnpack": [
      "node_modules/get-windows/main",
      "node_modules/get-windows/lib/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Limit читає лише домен активної вкладки, коли ввімкнено відстеження сайтів."
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "get-windows": "^9.3.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "get-windows": {
      "@mapbox/node-pre-gyp": "^2.0.3",
      "node-gyp": "^12.4.0"
    }
  }
}
