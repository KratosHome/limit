# Copy to services/feedback/.env on the relay host and enter server-only secrets.
# Never place these values in VITE_* variables or package them with Limit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=

FEEDBACK_HOST=127.0.0.1
FEEDBACK_PORT=8787
# Set to loopback only behind a local HTTPS proxy that OVERWRITES X-Real-IP.
FEEDBACK_TRUST_PROXY=none
